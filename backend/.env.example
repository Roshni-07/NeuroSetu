# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://neuro_user:neuro_secure_password@localhost:5432/neurosetu_db

# Redis Configuration (Session caching & rate limiting)
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET_KEY=replace_with_a_64_character_cryptographically_secure_random_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days offline grace allowance

# Bhashini ULCA API Credentials (Government of India Indic Language Models)
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# Environment & Observability
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://neurosetu.in
