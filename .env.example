# ==============================================================================
# NeuroSetu Environment Variables & Cloud Voice API Keys
# ==============================================================================
# NeuroSetu works 100% offline out-of-the-box using the browser Web Speech API.
# To upgrade to ultra-realistic, studio-quality Indian voices and neural accents,
# copy this file to .env and add any of the API keys below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ElevenLabs API (Ultra-realistic, human-like voice AI with Indian accents)
# Get a free key at: https://elevenlabs.io
# Supports: Hindi, Bengali, Assamese, Indian English, and 29+ languages
# ------------------------------------------------------------------------------
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ------------------------------------------------------------------------------
# 2. OpenAI Text-to-Speech API (Extremely fast, natural neural speech)
# Get a key at: https://platform.openai.com/api-keys
# Voices: 'nova' (warm female), 'shimmer', 'alloy', 'echo', 'fable', 'onyx'
# ------------------------------------------------------------------------------
VITE_OPENAI_API_KEY=
VITE_OPENAI_VOICE=nova

# ------------------------------------------------------------------------------
# 3. Google Cloud Text-to-Speech API
# Get a key at: https://console.cloud.google.com
# Neural2 & WaveNet Indian voices: hi-IN-Neural2-A, bn-IN-Wavenet-A, en-IN-Neural2-A
# ------------------------------------------------------------------------------
VITE_GOOGLE_TTS_API_KEY=

# ------------------------------------------------------------------------------
# 4. Microsoft Azure Cognitive Speech API
# Get a key at: https://portal.azure.com (Free tier: 500k chars/month)
# Studio Indian voices: hi-IN-SwaraNeural, en-IN-NeerjaNeural, bn-IN-TanishaaNeural, as-IN-YashicaNeural
# ------------------------------------------------------------------------------
VITE_AZURE_SPEECH_KEY=
VITE_AZURE_SPEECH_REGION=centralindia

# ------------------------------------------------------------------------------
# 5. Bhashini Cloud API (Govt of India ULCA / Dhruva AI Pipeline)
# Request key at: https://bhashini.gov.in
# Authentic support for all 22 scheduled Indian languages (Assamese, Bodo, Manipuri, etc.)
# ------------------------------------------------------------------------------
VITE_BHASHINI_API_KEY=
VITE_BHASHINI_USER_ID=

# ------------------------------------------------------------------------------
# 6. Supabase Telemetry & Offline Data Sync (Optional)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
